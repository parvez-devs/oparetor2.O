{
  "expo": {
    "name": "UID 2.O",
    "slug": "uid-2o-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "uidzone",
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "android": {
      "package": "com.parvezdevs.uidzone",
      "versionCode": 2,
      "permissions": [
        "INTERNET",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#081426",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.parvezdevs.uidzone",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "icon": "./assets/icon.png"
  }
}
